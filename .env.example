GITHUB_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5.4
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=gpt-5.4=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_REASONING_EFFORT=low

# HTTPS Redis REST endpoint supporting GET, SET NX EX and EVAL.
# Required in production unless explicitly running on a single instance.
GITTOSKILL_REDIS_REST_URL=
GITTOSKILL_REDIS_REST_TOKEN=
GITTOSKILL_ALLOW_MEMORY_STORE=false
GITTOSKILL_CACHE_TTL_SECONDS=43200
GITTOSKILL_REQUEST_LIMIT=30
GITTOSKILL_HOURLY_GENERATION_LIMIT=100
GITTOSKILL_MAX_CONCURRENT=4
# Enable only behind a proxy which overwrites x-forwarded-for.
GITTOSKILL_TRUST_PROXY=false

NEXT_PUBLIC_SITE_URL=https://gittoskill.vercel.app
NEXT_PUBLIC_ENABLE_ANALYTICS=false
